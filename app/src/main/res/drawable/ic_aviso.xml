<?xml version="1.0" encoding="utf-8"?>
<!--
    O icone da barra de status, nos avisos.

    O Android joga fora TODA a cor de um icone de notificacao e usa so o canal
    alfa: o desenho vira um recorte, pintado de branco na barra e da cor de
    destaque no aviso expandido. Por isso nao adianta mandar `ic_launcher`, que
    e uma placa quadrada com fundo — o recorte de um quadrado cheio e um
    quadrado branco, e era isso que apareceria.

    Mesma geometria de `ic_launcher_monocromo` — a carinha —, so que ampliada.
    A arte nasce ocupando 65 dos 108 de altura, com folga de sobra para o
    lancador recortar em circulo; na barra de status nao ha recorte nenhum, e
    essa folga viraria uma carinha pequena demais para ser reconhecida a 24 dp.
    O grupo escala em torno de (54,54), que ja e o centro da arte.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.45"
        android:scaleY="1.45">

        <path
            android:pathData="M54,38.8 m-17.6,0 a17.6,17.6 0 1,1 35.2,0 a17.6,17.6 0 1,1 -35.2,0"
            android:fillColor="#FFFFFFFF" />

        <path
            android:pathData="M38,74 C38,86.8 70,86.8 70,74"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6.4"
            android:strokeLineCap="round" />
    </group>
</vector>
